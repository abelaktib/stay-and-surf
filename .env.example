# Copiez ce fichier en .env.local pour tester en local.
# Sur Vercel : Project > Settings > Environment Variables.

# Adresse publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=https://stayandsurf.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@stayandsurf.com
# WhatsApp au format international sans + ni espaces, ex. 212600000000
NEXT_PUBLIC_WHATSAPP=
# Nom du compte Instagram, sans @
NEXT_PUBLIC_INSTAGRAM=

# Stripe : dashboard.stripe.com > Développeurs > Clés API
# Commencez avec la clé de test sk_test_..., passez à sk_live_... au lancement
STRIPE_SECRET_KEY=

# Flux iCal à IMPORTER (les dates prises sur Airbnb et Booking)
AIRBNB_ICAL_URL=
BOOKING_ICAL_URL=

# Facultatif : protège l'URL du calendrier exporté (/api/calendar.ics?token=...)
ICAL_EXPORT_TOKEN=
